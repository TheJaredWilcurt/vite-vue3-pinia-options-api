{
  "name": "vue-vite-pinia",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview --port 4173",
    "test": "cross-env TZ=America/New_York vitest run --coverage",
    "unit": "cross-env TZ=America/New_York vitest --coverage",
    "lint": "eslint --ext .js,.vue src tests vite.config.js eslint.config.js",
    "fix": "npm run lint -- --fix",
    "proto": "proto pin node latest --resolve && proto pin npm latest --resolve && git status"
  },
  "ManifestComments": [],
  "dependencies": {
    "pinia": "^3.0.2",
    "vue": "^3.5.27",
    "vue-options-api-constants-plugin": "^1.0.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@pinia/testing": "^1.0.3",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-tjw-base": "^4.3.0",
    "eslint-config-tjw-import": "^2.0.0",
    "eslint-config-tjw-jest": "^3.0.1",
    "eslint-config-tjw-vue": "^4.0.0",
    "eslint-import-resolver-vite": "^2.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-vue": "^10.7.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "globals": "^17.0.0",
    "happy-dom": "^20.3.4",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.17",
    "vue-dev-tools-accessibility": "^0.5.3",
    "vue3-snapshot-serializer": "^2.13.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.55.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "25.4.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.8.0"
    }
  }
}
