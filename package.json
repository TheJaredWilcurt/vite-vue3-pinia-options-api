{
  "name": "vue-vite-pinia",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview --port 4173",
    "test": "cross-env TZ=America/New_York vitest run --coverage",
    "unit": "cross-env TZ=America/New_York vitest --coverage",
    "lint": "eslint --ext .js,.vue src tests vite.config.js eslint.config.js",
    "fix": "npm run lint -- --fix",
    "proto": "proto pin node latest --resolve --tool-native && git status"
  },
  "ManifestComments": [],
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-options-api-constants-plugin": "^1.0.3",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-tjw-base": "^5.0.0",
    "eslint-config-tjw-import-x": "^1.0.1",
    "eslint-config-tjw-jest": "^4.0.0",
    "eslint-config-tjw-vue": "^4.0.1",
    "eslint-import-resolver-vite": "^2.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-dev-tools-accessibility": "^0.5.6",
    "vue3-snapshot-serializer": "^2.13.4"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.1"
    }
  }
}
